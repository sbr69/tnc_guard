CREATE TABLE reference_clauses (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    text            TEXT NOT NULL,
    category        TEXT NOT NULL,           -- ClauseCategory enum value
    risk_label      TEXT NOT NULL,           -- "standard" | "cautionary" | "risky"
    explanation     TEXT NOT NULL,           -- Why this label
    source          TEXT NOT NULL,           -- e.g., "Spotify ToS 2024"
    embedding       vector(768) NOT NULL,   -- Gemini text-embedding-004 output
    created_at      TIMESTAMPTZ DEFAULT NOW()
);

-- Index for fast vector similarity search
CREATE INDEX ON reference_clauses
    USING ivfflat (embedding vector_cosine_ops) WITH (lists = 20);

-- ============================================================
-- USER-UPLOADED DOCUMENTS
-- ============================================================
CREATE TABLE documents (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    filename        TEXT NOT NULL,
    raw_text        TEXT NOT NULL,
    document_type   TEXT DEFAULT 'custom',       -- "tos" | "lease" | "nda" | "custom"
    status          TEXT DEFAULT 'processing',   -- "processing" | "done" | "error"
    health_score    INT,
    summary         TEXT,
    error_message   TEXT,
    processing_time_seconds FLOAT,
    created_at      TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================================
-- EXTRACTED CLAUSES (from user documents)
-- ============================================================
CREATE TABLE clauses (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    doc_id          UUID REFERENCES documents(id) ON DELETE CASCADE,
    text            TEXT NOT NULL,
    section_path    TEXT,
    order_index     INT NOT NULL,
    char_offset_start INT,
    char_offset_end   INT,
    embedding       vector(768)               -- Clause embedding for retrieval
);

-- ============================================================
-- RISK FLAGS (analysis output per clause)
-- ============================================================
CREATE TABLE risk_flags (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    clause_id       UUID REFERENCES clauses(id) ON DELETE CASCADE,
    title           TEXT NOT NULL,
    category        TEXT NOT NULL,
    risk_level      TEXT NOT NULL,
    confidence      FLOAT NOT NULL,
    reasoning       TEXT NOT NULL,
    plain_language  TEXT NOT NULL,
    rag_comparison  TEXT NOT NULL,
    rule_flags      TEXT[] DEFAULT '{}',
    compared_reference_ids UUID[] DEFAULT '{}',
    section_location TEXT
);
```

